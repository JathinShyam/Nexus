#!/usr/bin/env bash
# Strip Cursor agent attribution trailers from commit messages.
# Cursor may append these even when the agent did not write them.
set -euo pipefail
msg_file="${1:-}"
[[ -n "$msg_file" && -f "$msg_file" ]] || exit 0

# Portable in-place edit (GNU or BSD sed)
tmp="$(mktemp)"
sed -E \
  -e '/^Co-authored-by:[[:space:]]*Cursor[[:space:]]*<cursoragent@cursor\.com>[[:space:]]*$/d' \
  -e '/^Made-with:[[:space:]]*Cursor[[:space:]]*$/d' \
  -e '/^Made with Cursor[[:space:]]*$/d' \
  "$msg_file" >"$tmp"
mv "$tmp" "$msg_file"
