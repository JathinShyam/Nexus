# Copy to `.env` and fill locally. Never commit `.env`.
# Values are filled in Phase 0 when Compose and the API exist.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://nexus_app:nexus_app@localhost:5432/nexus
DATABASE_MIGRATE_URL=postgres://nexus_migrator:nexus_migrator@localhost:5432/nexus

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536

ALLOW_SELF_TENANT=true
CORS_ORIGINS=http://localhost:3000
